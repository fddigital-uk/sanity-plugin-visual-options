{
  "name": "sanity-plugin-visual-options",
  "version": "3.0.0",
  "description": "A custom input for options to user by displaying a visual representation.",
  "keywords": [
    "display",
    "list",
    "options",
    "plugin",
    "plugins",
    "sanity",
    "sanity-plugin",
    "sanity.io",
    "sanityio",
    "visual"
  ],
  "homepage": "https://github.com/fractaldimensions/sanity-plugin-visual-options#readme",
  "bugs": {
    "url": "https://github.com/fractaldimensions/sanity-plugin-visual-options/issues"
  },
  "license": "ISC",
  "author": "Nick Taylor",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fractaldimensions/sanity-plugin-visual-options.git"
  },
  "files": [
    "dist",
    "sanity.json",
    "v2-incompatible.js"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "plugin-kit verify-package --silent && pkg-utils build --strict --check --clean",
    "clean": "rimraf dist",
    "format": "oxfmt",
    "link-watch": "plugin-kit link-watch",
    "lint": "oxlint",
    "prepublishOnly": "npm run build",
    "watch": "pkg-utils watch --strict"
  },
  "dependencies": {
    "@sanity/incompatible-plugin": "^1.0.5"
  },
  "devDependencies": {
    "@sanity/browserslist-config": "^1.0.5",
    "@sanity/pkg-utils": "^11.0.17",
    "@sanity/plugin-kit": "^10.0.3",
    "@types/react": "^19.2.18",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.77.0",
    "oxlint-tsgolint": "^7.0.2001",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-is": "^19.2.8",
    "rimraf": "^6.1.3",
    "rollup-plugin-postcss": "^4.0.2",
    "sanity": "^6.8.0",
    "styled-components": "^6.4.4",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "sanity": "^3.0.0 || ^4.0.0-0 || ^5.0.0 || ^6.0.0-0"
  },
  "browserslist": "extends @sanity/browserslist-config",
  "engines": {
    "node": ">=20.19 <22 || >=22.12"
  }
}
